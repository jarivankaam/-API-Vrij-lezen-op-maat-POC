# Copy to .env for local development (matches the credentials in docker-compose.yml).
# Run `docker compose up mongo postgres` to have these reachable from the host.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vrij-lezen-op-maat?schema=public"
MONGODB_URI="mongodb://127.0.0.1:27017/vrij-lezen-op-maat"

# Secret used to sign JWTs — set a strong random value outside of local dev.
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="1h"
